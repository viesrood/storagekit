{
    "name": "viesrood/storagekit",
    "description": "A private, S3-compatible filesystem for Craft CMS 5: Cloudflare R2, Backblaze B2, Wasabi, MinIO-style servers and any other provider with a custom endpoint, plus short-lived signed URLs.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "filesystem",
        "s3",
        "r2",
        "cloudflare",
        "object-storage",
        "signed-url"
    ],
    "support": {
        "docs": "https://github.com/viesrood/storagekit/blob/main/README.md",
        "issues": "https://github.com/viesrood/storagekit/issues",
        "source": "https://github.com/viesrood/storagekit"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0.0",
        "craftcms/flysystem": "^2.0.0",
        "league/flysystem-aws-s3-v3": "^3.29"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "viesrood\\storagekit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "viesrood\\storagekit\\tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "extra": {
        "handle": "storagekit",
        "name": "StorageKit",
        "class": "viesrood\\storagekit\\Plugin",
        "developer": "Viesrood",
        "developerUrl": "https://viesrood.nl",
        "documentationUrl": "https://github.com/viesrood/storagekit",
        "changelogUrl": "https://raw.githubusercontent.com/viesrood/storagekit/main/CHANGELOG.md"
    }
}
